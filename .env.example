# Database (SQLite)
DATABASE_URL=file:/data/tsk.db

# NextAuth
NEXTAUTH_SECRET=generate-a-random-32-byte-secret-here
NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true

# Bolt card service
BOLT_API_URL=http://bolt:3001
BOLT_API_KEY=
NEXT_PUBLIC_BOLT_URL=https://bolt.bitcoinekasi.xyz

# Users
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Per-group marshal passcodes (marshal login: group + passcode). Empty = group login disabled.
MARSHAL_PASSCODE_TURTLES=
MARSHAL_PASSCODE_SEALS=
MARSHAL_PASSCODE_DOLPHINS=
MARSHAL_PASSCODE_SHARKS=
MARSHAL_PASSCODE_FREE_SURFERS=

# Cron secret — must match the bearer token used in the monthly cron job
CRON_SECRET=generate-a-random-hex-secret-here

# Email notifications (Resend) — attendance submit/reminder/digest emails
# EMAIL_FROM must be on a domain verified in Resend (Domains tab must show "Verified")
RESEND_API_KEY=
EMAIL_FROM=tsk@mail.bitcoinekasi.xyz
